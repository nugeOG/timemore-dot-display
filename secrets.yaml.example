# Copy this to secrets.yaml (gitignored) and fill in real values.
#
# If you're building via the Home Assistant ESPHome add-on, it keeps one
# shared secrets.yaml for every device config in its folder — you may
# already have one; just add these keys to it rather than creating a
# second file.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Also authenticates OTA updates -- ota: inherits this key rather than
# using a separate password, so there's only one secret to manage here.
api_encryption_key: "REPLACE_WITH_A_GENERATED_32_BYTE_BASE64_KEY"

# Only needed if you uncomment the `mqtt:` block in timemore-dot-display.yaml.
# mqtt_broker: "192.168.1.10"
# mqtt_username: "your-mqtt-username"
# mqtt_password: "your-mqtt-password"
